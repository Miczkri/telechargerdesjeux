---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => (
      <div class={i === 0 && fluid != false ? "col-12" : "col-12 sm:col-6"}>
        {post.data.image && (
          <a
            href={`/${post.id}`}
            class="rounded-lg block hover:text-primary overflow-hidden group"
          >
            <Image
              class="w-full rounded-lg"
              src={post.data.image}
              alt={post.data.title}
              width={i === 0 ? 925 : 445}
              height={i === 0 ? 475 : 230}
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              
            />
          </a>
        )}
        <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
          <li class="mr-5">
            {authors
              .filter((author) =>
                post.data.authors
                  .map((author) => slugify(author))
                  .includes(slugify(author.data.title))
              )
              .map((author) => (
                <a
                  href={`/auteur/${slugify(author.data.title)}`}
                  class="flex items-center hover:text-primary font-medium"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={50}
                      width={50}
                      class="mr-2 h-6 w-6 rounded-full"
                    />
                  )}
                  <span>{author.data.title}</span>
                </a>
              ))}
          </li>
          <li class="mr-5 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(post.data.date!)}
          </li>
          <li class="mr-5 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {post.data.categories.map((category, i: number) => (
                <li class="inline-block">
                  <a
                    href={`/categorie/${slugify(category)}`}
                    class="mr-2 hover:text-primary font-medium"
                  >
                    {humanize(category)}
                    {i !== post.data.categories.length - 1 && ","}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
        <h2 class="mb-4">
          <a
            href={`/${post.id}`}
            class="block hover:text-primary transition duration-300"
          >
            {post.data.title}
          </a>
        </h2>
        <p class="text-text line-clamp-2">{plainify(post.body ?? "")}</p>
      </div>
    ))
  }
      <div class="mt-16 pt-8 border-t border-border">
        <h1 class="h5 mb-4">Télécharger des jeux gratuitement</h1>
        <p class="mb-4">
  <div id="seo-content" class="relative max-h-[300px] overflow-hidden transition-all duration-500 ease-in-out">
    <p class="mb-4">
      Bonjour, joueur ! Plongez dans l’univers de vos jeux PC préférés sur telechargerdesjeux.com !
      Notre portail moderne est un véritable paradis pour les passionnés de divertissement numérique. 
      Chaque joueur sur PC y trouvera son bonheur. Chez nous, vous pouvez télécharger des jeux PC gratuitement !
    </p>

    <p class="mb-6">
      Sur notre site, tu trouveras aussi bien des classiques cultes que des nouveautés. 
      Des jeux de ton enfance et les derniers succès. Nous espérons que notre arborescence de catégories détaillée 
      te facilitera la navigation et la recherche de perles rares. Jouer sur PC n’a jamais été aussi simple et accessible !
    </p>

    <h3 class="h5 mt-8 mb-4">Les catégories de jeux PC les plus populaires</h3>

    <div class="space-y-4 mb-8">
      <div>
        <h3 class="h6 font-bold mb-1">Jeux d’action</h3>
        <p>
          Le plus grand groupe de productions sur PC, qui présente en même temps un modèle de gameplay vraiment varié. 
          C’est l’action qui compte ! Les mécanismes, quant à eux, sont variés. C’est ici que vous trouverez les plus grands jeux, 
          les plus gros budgets et le plus grand panache. À cela s’ajoutent une trame narrative riche et un aspect cinématographique. 
          Les jeux d’action sont tout simplement des jeux sympas !
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Jeux de stratégie</h3>
        <p>
          Préparez vos tactiques, commandant. Dans cette sous-catégorie, vous prendrez le commandement de vos troupes. 
          Que ce soit en mode tour par tour, en RTS ou en mode mixte. Les jeux de stratégie sur PC offrent quelque chose de vraiment unique. 
          Vous pouvez y conquérir, coloniser, combattre, développer, construire, etc. Chaque stratégie offre quelque chose de différent, 
          mais chacune est vraiment captivante. Attention !
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Jeux FPS</h3>
        <p>
          Des jeux de tir virtuels. Des champs de bataille où vous incarnez un soldat. Peu importe qu’il s’agisse de jeux de tir 
          en ligne ou coopératifs. Dans ce genre, vous devrez beaucoup tirer sur divers adversaires. Mettez à profit vos compétences 
          en ligne, coopérez et entraînez-vous à réagir rapidement, et peut-être en sortirez-vous vivant.
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Jeux de simulation</h3>
        <p>
          Les simulations constituent un énorme domaine ! Ce sont des jeux qui allient détente, gestion et divertissement. 
          Il existe aujourd’hui une multitude de simulateurs et chacun trouve ses adeptes. Chaque système est unique. 
          Gérer une ferme, un garage ou sa propre équipe sportive. Ici, tout me semble à la fois très réaliste et tout simplement possible !
        </p>
      </div>

      <div>
        <h3 class="h6 font-bold mb-1">Jeux RPG</h3>
        <p>
          Des jeux de rôle dans leur forme la plus pure. Créez votre propre héros, choisissez sa classe, aventurez-vous dans les donjons 
          et gagnez de l’expérience. Ces jeux vous permettent tout. Utilisez une magie mystérieuse et un équipement de choix. 
          Les éléments de développement du personnage sont présents dans de nombreux jeux, mais ce n’est que dans les RPG qu’ils atteignent un tel niveau. 
          Chaque monde séduit par son ampleur et rend l’impossible possible. Découvrez les RPG fantastiques dans lesquels vous affrontez de terribles monstres. 
          Testez les RPG d’action qui mettent l’accent sur l’intrigue et un gameplay agréable. Ou peut-être préférez-vous quelque chose d’historique ? 
          Il y a aussi des titres de ce genre ! Le plaisir est sans limite : on incarne un personnage et on se lance dans l’aventure dans un monde ouvert ! 
          Qu’est-ce qui pourrait mal tourner ?
        </p>
      </div>
    </div>

    <h3 class="h5 mt-8 mb-4">Les jeux PC les plus populaires du marché</h3>

    <p class="mb-4">
      C’est un vaste sujet. Quel est le jeu le plus populaire ? Nous n’essaierons même pas de répondre à cette question. 
      Chacun a ses préférences, après tout. Nous vous présenterons toutefois quelques titres qui se vendent le mieux dans notre boutique. 
      Nous faisons confiance à nos clients ! Ce serait un péché de ne pas mentionner The Witcher ou Diablo, mais ce n’est pas encore à cette échelle. 
      Chez nous, ce sont d’autres productions auxquelles vous n’auriez pas pensé qui règnent en maître. Il s’agit par exemple de Cyberpunk 2077, <a href="/resident-evil-requiem-gratuit-a-telecharger" class="text-primary underline">Resident Evil Requiem</a> ou Hogwarts Legacy. Comme d’habitude, <a href="/gta-5-gratuit" class="text-primary underline">GTA 5</a> et <a href="/red-dead-redemption-2-gratuit-a-telecharger" class="text-primary underline">Red Dead Redemption 2</a> se maintiennent en tête – Rockstar ne déçoit jamais !
    </p>

    <p class="mb-4">
      Ces dernières années, les jeux au niveau de difficulté très élevé connaissent un véritable renouveau. 
      Sur le piédestal se trouvent bien sûr la série Dark Souls et <a href="/elden-ring-a-telecharger-gratuitement" class="text-primary underline">Elden Ring</a>. Les best-sellers de From Software ont défini le genre « soulslike » et se vendent comme des petits pains. <a href="/telecharger-crimson-desert-gratuitement" class="text-primary underline">Crimson Desert</a> est également l’un des nouveaux jeux les plus intéressants.
    </p>

    <p class="mb-4">
      Quand on parle du marché polonais, impossible de passer à côté de la série <a href="/farming-simulator-25-gratuit-a-telecharger" class="text-primary underline">Farming Simulator</a>. Des millions de joueurs à travers le monde ne peuvent pas se tromper. Si tu ris, c’est que tu ne sais vraiment pas de quoi il s’agit. 
      Des machines sous licence, ta propre ferme, ton personnage, des éléments de microgestion et bien plus encore. 
      Ce succès repose sur une multitude de facteurs. Cela ne nous surprend pas du tout !
    </p>

    <p class="mb-4">
      Tuer des monstres, c’est toujours génial, et cette fois-ci, impossible de ne pas mentionner Monster Hunter. 
      Les arènes avec des boss gigantesques ne sont que la partie émergée de l’iceberg. Qui ne voudrait pas devenir chasseur de bêtes géantes ? Mais qui donc ?!
    </p>

    <p class="mb-6">
      Les jeux de sport sont également un plaisir pour le grand public. Nous laisserons de côté <a href="/ea-sports-fc-26-gratuit-a-telecharger" class="text-primary underline">EA Sports FC</a> et nous concentrerons cette fois-ci sur le basket-ball. NBA 2K est une série phénoménale, pleine de compétition, 
      de progression et de missions spéciales. Chaque point marqué est une joie, et les graphismes sont époustouflants. 
      Un paradis pour les basketteurs, nous le recommandons !
    </p>

    <h3 class="h5 mt-8 mb-4">Amuse-toi bien</h3>

    <p class="mb-4">
      Nous n’avons même pas mentionné 1 % de toutes les productions que nous proposons. Il est logique que la plupart restent un mystère. 
      Elles sont cachées dans les secrets de notre site. Nous vous encourageons à les découvrir ! Nous avons des jeux pour toutes les occasions, 
      pour les joueurs de tous âges. Les univers de Star Wars ou du Seigneur des Anneaux ne nous sont pas étrangers. 
      Nous prenons en charge toutes les plateformes de distribution numérique. Nous collaborons avec de grandes entreprises et des développeurs indépendants. 
      Nous adorons les jeux !
    </p>

    <p class="mb-4">
      Les jeux PC sont notre passion : faites-nous confiance et embarquez pour un voyage de plaisir numérique. 
      Suivez-nous sur les réseaux sociaux et téléchargez des jeux gratuitement depuis une source fiable. Bienvenue !
    </p>

    <div id="seo-overlay" class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-body to-transparent pointer-events-none"></div>
  </div>

  <div class="text-center mt-4">
    <button id="seo-toggle-btn" class="btn btn-outline-primary text-sm px-6 py-2">
      Lire la suite
    </button>
  </div>

<script>
  const content = document.getElementById('seo-content');
  const overlay = document.getElementById('seo-overlay');
  const btn = document.getElementById('seo-toggle-btn');

  if (content && overlay && btn) {
    btn.addEventListener('click', () => {
      const isExpanded = content.classList.contains('max-h-full');

      if (isExpanded) {
        // Zwijanie
        content.classList.remove('max-h-full');
        content.classList.add('max-h-[300px]');
        overlay.classList.remove('hidden');
        btn.textContent = 'Lire la suite';
      } else {
        // Rozwijanie
        content.classList.remove('max-h-[300px]');
        content.classList.add('max-h-full');
        overlay.classList.add('hidden');
        btn.textContent = 'Réduire';
      }
    });
  }
</script>
        </p>
      </div>
</div>
